<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootStack"
           xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.quickmaster.ui.MainController"
           prefWidth="1180" prefHeight="820">

<BorderPane fx:id="rootPane" styleClass="root-pane"
            maxWidth="Infinity" maxHeight="Infinity">

    <top>
        <VBox>
            <!-- Command bar -->
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="top-bar">
                <padding><Insets top="9" right="14" bottom="9" left="14"/></padding>
                <Button text="Load file" onAction="#onLoadFile" styleClass="action-button"/>
                <Button text="Reset" onAction="#onReset"/>
                <Button fx:id="undoButton" text="↶ Undo" onAction="#onUndo"/>
                <Button fx:id="redoButton" text="↷ Redo" onAction="#onRedo"/>
                <Separator orientation="VERTICAL"/>
                <Label text="Preset:" styleClass="caption"/>
                <Button text="Save…" onAction="#onSavePreset"/>
                <Button text="Load…" onAction="#onLoadPreset"/>
                <Label text="A/B:" styleClass="caption"/>
                <HBox spacing="0" alignment="CENTER_LEFT" styleClass="ab-switch">
                    <ToggleButton fx:id="slotAButton" text="A" selected="true"
                                  onAction="#onSelectSlotA" styleClass="ab-seg,ab-seg-left"/>
                    <ToggleButton fx:id="slotBButton" text="B"
                                  onAction="#onSelectSlotB" styleClass="ab-seg,ab-seg-right"/>
                </HBox>
                <Separator orientation="VERTICAL"/>
                <Label text="File:" styleClass="caption"/>
                <Label fx:id="fileNameLabel" text="(none)" styleClass="value"/>
                <Label fx:id="fileInfoLabel" text="" styleClass="value-muted"/>
                <Label fx:id="topBpmLabel" text="" styleClass="value"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Measure" onAction="#onMeasureLufs"/>
                <Button text="Batch…" onAction="#onBatchExport"/>
                <Button text="Export…" onAction="#onExport" styleClass="action-button"/>
            </HBox>

            <!-- Processing-chain tab bar (signal order; drag to reorder) -->
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="chain-row">
                <padding><Insets right="12"/></padding>
                <ScrollPane styleClass="chain-scroll" fitToHeight="true" HBox.hgrow="ALWAYS"
                            hbarPolicy="AS_NEEDED" vbarPolicy="NEVER">
                    <HBox fx:id="chainBar" styleClass="chain-bar" spacing="6" alignment="CENTER_LEFT">
                        <padding><Insets top="6" right="12" bottom="6" left="12"/></padding>
                    </HBox>
                </ScrollPane>
            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane fx:id="moduleContent" styleClass="module-content">
            <padding><Insets top="10" right="10" bottom="6" left="14"/></padding>

            <!-- General panel: equalizer (tone + routing + dynamics) -->
            <VBox fx:id="eqPanel" styleClass="eq-panel" spacing="0"
                  maxWidth="Infinity" maxHeight="Infinity">
                <HBox alignment="CENTER_RIGHT" spacing="6">
                    <padding><Insets top="8" right="12" bottom="6" left="12"/></padding>
                    <CheckBox fx:id="eqEnabled" text="enabled" selected="true" styleClass="enable-check"/>
                </HBox>

                <!-- EQ curve fills the card edge to edge (no padding gap) -->
                <Pane fx:id="eqCanvasWrapper" styleClass="eq-canvas-wrapper"
                      VBox.vgrow="ALWAYS" minHeight="150">
                    <Canvas fx:id="eqCanvas" width="700" height="230"/>
                </Pane>

                <VBox spacing="18">
                    <padding><Insets top="18" right="12" bottom="10" left="12"/></padding>
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Button text="+ Band" onAction="#onAddBand"/>
                        <Label text="Band:" styleClass="caption"/>
                        <ComboBox fx:id="eqBandSelector"/>
                        <ComboBox fx:id="eqType"/>
                        <ComboBox fx:id="eqChannel"/>
                        <ComboBox fx:id="eqPhase"/>
                        <ComboBox fx:id="eqSlope"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <CheckBox fx:id="eqDynamic" text="dynamic" styleClass="enable-check"/>
                        <CheckBox fx:id="autoEqOn" text="Auto EQ" styleClass="enable-check"/>
                    </HBox>
                    <HBox fx:id="eqKnobs" alignment="TOP_LEFT" spacing="5" styleClass="eq-knob-row">
                        <padding><Insets top="0" bottom="0"/></padding>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Dynamics panel: the four automatic compressors (built in code),
                 sized to fit on one screen without scrolling. -->
            <VBox fx:id="dynamicsPanel" styleClass="eq-panel" spacing="6"
                  visible="false" managed="false" maxWidth="Infinity" maxHeight="Infinity">
                <padding><Insets top="8" right="10" bottom="8" left="10"/></padding>
                <HBox alignment="CENTER_RIGHT" spacing="6">
                    <CheckBox fx:id="dynMasterEnabled" text="enabled" styleClass="enable-check"/>
                </HBox>
                <!-- Four equal square cards (2x2), inserted/placed in code. Each
                     shows its chain position number and can be dragged to reorder. -->
                <GridPane fx:id="dynamicsGrid" hgap="8" vgap="8" VBox.vgrow="ALWAYS">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints percentHeight="50" vgrow="ALWAYS"/>
                        <RowConstraints percentHeight="50" vgrow="ALWAYS"/>
                    </rowConstraints>
                </GridPane>
            </VBox>

            <!-- Clip panel: hard / soft clipper (DSP to follow). -->
            <VBox fx:id="clipPanel" styleClass="eq-panel" spacing="8"
                  visible="false" managed="false" maxWidth="Infinity" maxHeight="Infinity">
                <padding><Insets top="10" right="12" bottom="10" left="12"/></padding>
                <HBox alignment="CENTER_RIGHT" spacing="6">
                    <CheckBox fx:id="clipEnabled" text="enabled" styleClass="enable-check"/>
                </HBox>
                <HBox fx:id="clipCards" alignment="CENTER" spacing="12" VBox.vgrow="ALWAYS"/>
            </VBox>

            <!-- Limit panel: automatic two-stage true-peak limiter.
                 Multiband (top) + Broadband (bottom) are built in initLimiterUi(). -->
            <VBox fx:id="limiterPanel" styleClass="eq-panel" spacing="10"
                  visible="false" managed="false" maxWidth="Infinity" maxHeight="Infinity">
                <padding><Insets top="10" right="12" bottom="10" left="12"/></padding>
                <HBox alignment="CENTER_RIGHT" spacing="6">
                    <CheckBox fx:id="limEnabled" text="on" styleClass="enable-check"/>
                </HBox>
                <VBox fx:id="limContent" spacing="10" VBox.vgrow="ALWAYS" maxWidth="Infinity"/>
            </VBox>
        </StackPane>
    </center>

    <right>
        <!-- Three vertically-symmetric sections (equal share of the height):
             loudness metering, peak normalizer, oversampling. -->
        <VBox styleClass="meter-panel" spacing="0">

            <!-- 1 / 3 - Loudness metering -->
            <VBox styleClass="meter-section" spacing="6" VBox.vgrow="ALWAYS">
                <padding><Insets top="18" right="14" bottom="10" left="14"/></padding>
                <Label text="LOUDNESS" styleClass="section-header"/>
                <Label fx:id="meterLufs" text="·" styleClass="meter-big"/>
                <Separator/>
                <HBox spacing="6"><Label text="Short" styleClass="caption" minWidth="56"/>
                    <Region HBox.hgrow="ALWAYS"/><Label fx:id="meterShort" text="·" styleClass="value"/></HBox>
                <HBox spacing="6"><Label text="Momentary" styleClass="caption" minWidth="56"/>
                    <Region HBox.hgrow="ALWAYS"/><Label fx:id="meterMom" text="·" styleClass="value"/></HBox>
                <HBox spacing="6"><Label text="LRA" styleClass="caption" minWidth="56"/>
                    <Region HBox.hgrow="ALWAYS"/><Label fx:id="meterLra" text="·" styleClass="value"/></HBox>
                <HBox spacing="6"><Label text="True peak" styleClass="caption" minWidth="56"/>
                    <Region HBox.hgrow="ALWAYS"/><Label fx:id="meterPeak" text="·" styleClass="value"/></HBox>
                <HBox spacing="6"><Label text="Lim GR" styleClass="caption" minWidth="56"/>
                    <Region HBox.hgrow="ALWAYS"/><Label fx:id="meterGr" text="·" styleClass="value"/></HBox>
                <Separator/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Canvas fx:id="gonioCanvas" width="76" height="76"/>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <HBox spacing="6"><Label text="Corr" styleClass="caption" minWidth="36"/>
                            <Region HBox.hgrow="ALWAYS"/><Label fx:id="meterCorr" text="·" styleClass="value"/></HBox>
                        <HBox spacing="6"><Label text="Mid" styleClass="caption" minWidth="36"/>
                            <Region HBox.hgrow="ALWAYS"/><Label fx:id="meterMid" text="·" styleClass="value"/></HBox>
                        <HBox spacing="6"><Label text="Side" styleClass="caption" minWidth="36"/>
                            <Region HBox.hgrow="ALWAYS"/><Label fx:id="meterSide" text="·" styleClass="value"/></HBox>
                    </VBox>
                </HBox>
            </VBox>

            <Separator/>

            <!-- 2 / 3 - Peak normalizer (target is a slider) -->
            <VBox styleClass="meter-section" spacing="8" VBox.vgrow="ALWAYS">
                <padding><Insets top="14" right="14" bottom="10" left="14"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Label text="PEAK NORMALIZER" styleClass="section-header"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <CheckBox fx:id="peakEnabled" text="on" styleClass="enable-check"/>
                </HBox>
                <HBox spacing="6"><Label text="In peak" styleClass="caption" minWidth="56"/>
                    <Region HBox.hgrow="ALWAYS"/><Label fx:id="peakInputLabel" text="·" styleClass="value"/></HBox>
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Label text="Target" styleClass="caption" minWidth="56"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="peakTargetLabel" text="-1.0 dBTP" styleClass="value"/>
                </HBox>
                <Slider fx:id="peakTarget" min="-24" max="0" value="-1"/>
                <HBox spacing="6"><Label text="Gain" styleClass="caption" minWidth="56"/>
                    <Region HBox.hgrow="ALWAYS"/><Label fx:id="peakAppliedLabel" text="·" styleClass="value-muted"/></HBox>
                <Button text="Recalculate Peak" onAction="#onRecalculatePeak" maxWidth="Infinity"/>
            </VBox>

            <Separator/>

            <!-- 3 / 3 - Oversampling (live + offline render) -->
            <VBox styleClass="meter-section" spacing="8" VBox.vgrow="ALWAYS">
                <padding><Insets top="14" right="14" bottom="12" left="14"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Label text="OVERSAMPLING" styleClass="section-header"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <ToggleButton fx:id="osToggle" text="off"/>
                </HBox>
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Label text="Factor" styleClass="caption" minWidth="56"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <ComboBox fx:id="osCombo"/>
                </HBox>
            </VBox>
        </VBox>
    </right>

    <bottom>
        <VBox styleClass="monitor-bar">
            <Pane fx:id="waveformWrapper" styleClass="waveform-wrapper" minHeight="140" prefHeight="140">
                <Canvas fx:id="waveformCanvas" height="140" width="800"/>
            </Pane>

            <HBox spacing="8" alignment="CENTER_LEFT" styleClass="transport-bar">
                <padding><Insets top="6" right="10" bottom="6" left="10"/></padding>
                <Button fx:id="goStartButton" text="⏮" onAction="#onGoToStart" styleClass="transport-icon"/>
                <Button fx:id="playButton" text="▶ Play" onAction="#onPlayPause" styleClass="transport-play"/>
                <Button fx:id="stopButton" text="⏹ Stop" onAction="#onStop" styleClass="transport-button"/>
                <Button fx:id="goEndButton" text="⏭" onAction="#onGoToEnd" styleClass="transport-icon"/>
                <ToggleButton fx:id="abButton" text="Bypass" onAction="#onToggleAB" styleClass="transport-toggle"/>
                <ToggleButton fx:id="loopButton" text="Loop" onAction="#onToggleLoop" styleClass="transport-toggle"/>
                <Separator orientation="VERTICAL"/>
                <Label fx:id="positionLabel" text="0:00.000 / 0:00.000" styleClass="time-display"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Trim:" styleClass="caption"/>
                <Label fx:id="selectionLabel" text="shift-drag the wave to select"
                       styleClass="value-muted" minWidth="150"/>
                <Button text="Crop" onAction="#onCropSelection"/>
                <Button text="Delete" onAction="#onDeleteSelection"/>
                <Button text="Clear" onAction="#onClearSelection"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="status-bar">
                <padding><Insets top="5" right="14" bottom="5" left="14"/></padding>
                <Label fx:id="statusLabel" text="Ready." styleClass="status-text"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="analyzeLabel" text="Analyzing audio…" styleClass="status-text" visible="false" managed="false"/>
                <ProgressBar fx:id="analyzeProgress" prefWidth="160" progress="-1.0" visible="false" managed="false"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>

    <!-- Export overlay: a full-window veil + centred card that blocks all
         interaction while an export runs. Sibling of rootPane in the StackPane,
         so disabling rootPane never disables the Cancel button. -->
    <VBox fx:id="exportOverlay" styleClass="export-overlay" alignment="CENTER"
          maxWidth="Infinity" maxHeight="Infinity"
          visible="false" managed="false">
        <VBox styleClass="export-card" alignment="CENTER" spacing="14"
              maxWidth="440" maxHeight="-Infinity">
            <padding><Insets top="26" right="32" bottom="26" left="32"/></padding>
            <Label fx:id="exportTitleLabel" text="Exporting" styleClass="section-header"/>
            <Label fx:id="exportFileLabel" text="" styleClass="value"/>
            <ProgressBar fx:id="exportBar" prefWidth="320" progress="0.0"/>
            <Label fx:id="exportPercentLabel" text="0 %" styleClass="value"/>
            <Label fx:id="exportTimeLabel" text="" styleClass="caption"/>
            <Button text="Cancel" onAction="#onCancelExport" styleClass="action-button"/>
        </VBox>
    </VBox>
</StackPane>
