# Normalize line endings: store text as LF in the repository.
* text=auto

*.java       text eol=lf
*.xml        text eol=lf
*.css        text eol=lf
*.fxml       text eol=lf
*.md         text eol=lf
*.properties text eol=lf
*.gitignore  text eol=lf
mvnw         text eol=lf

# Windows scripts keep CRLF.
*.cmd        text eol=crlf
*.bat        text eol=crlf

# Binary assets (never modified or diffed as text).
*.png        binary
*.jar        binary
